    <!-- پشتیبان حساب -->
    <string name="backup_title">پشتیبان‌گیری از حساب</string>
    <string name="backup_settings_body">حساب شما یک کلید مخفی است که فقط روی همین گوشی است. از آن پشتیبان بگیرید تا اگر گوشی گم، بازنشانی یا پاک شد بتوانید آن را برگردانید.</string>
    <string name="backup_body">یک گذرواژه انتخاب کنید. پشتیبان بدون آن به کار نمی‌آید، و هر کس هم پشتیبان و هم گذرواژه را داشته باشد می‌تواند پیام‌های شما را بخواند و به نام شما بنویسد. این دو را در جاهای جدا نگه دارید.</string>
    <string name="backup_pass_label">گذرواژه</string>
    <string name="backup_pass_helper">دست‌کم %1$d نویسه. قابل بازیابی نیست.</string>
    <string name="backup_pass_again">تکرار گذرواژه</string>
    <string name="backup_pass_mismatch">گذرواژه‌ها یکی نیستند</string>
    <string name="backup_failed">ساختن پشتیبان نشد. دوباره تلاش کنید.</string>
    <string name="backup_create">ساختن پشتیبان</string>
    <string name="backup_done_title">پشتیبان شما</string>
    <string name="backup_done_body">این کد QR یا متن را جایی امن و دور از این گوشی نگه دارید: چاپش کنید یا در یک گذرواژه‌نگهدار بگذارید. برای برگرداندن، هنگام راه‌اندازی برنامه «پشتیبان دارم» را بزنید.</string>
    <string name="backup_qr_description">کد QR پشتیبان حساب شما</string>
    <string name="backup_copy">کپی</string>
    <string name="backup_close">تمام</string>
    <string name="onb_restore">پشتیبان دارم</string>
    <string name="restore_title">برگرداندن حساب</string>
    <string name="restore_body">متن پشتیبان (که با meshkey1: شروع می‌شود) را بچسبانید و گذرواژه‌اش را بنویسید. مخاطبان و پیام‌ها در پشتیبان نیستند؛ پیوند شما همان می‌ماند. حساب را هر بار فقط روی یک دستگاه به کار ببرید.</string>
    <string name="restore_backup_label">پشتیبان</string>
    <string name="restore_err_format">این پشتیبان حساب نیست</string>
    <string name="restore_err_passphrase">گذرواژه نادرست است یا پشتیبان آسیب دیده</string>
    <string name="restore_err_other">برگرداندن حساب نشد</string>
    <string name="restore_confirm">برگرداندن</string>
