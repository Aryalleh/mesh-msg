    <!-- Trip location sharing (docs/trip.md) -->
    <string name="trips_title">Trips</string>
    <string name="trips_entry">Trips: location sharing</string>
    <string name="trips_entry_help">For a group trip: share your position with the trip\'s leaders so they can find you if you get lost.</string>
    <string name="trips_intro">On a group trip, your phone can send your position to the trip\'s leaders every few minutes, encrypted so only they can read it: over Bluetooth to nearby phones, over LoRa and through the trip\'s relay, even without internet on your phone. Nothing is sent until you agree, and you can stop at any time.</string>
    <string name="trip_until_leaders">Until %1$s · leaders: %2$s</string>
    <string name="trip_ended">This trip has ended. Nothing is sent any more.</string>
    <string name="trip_consent_body">This trip asks to see where you are. If you agree, your phone sends your position every %2$d minutes to the trip\'s leaders (%1$s) until %3$s, so they can find you if you get lost. Only they can read it: not other members, not the relay. You can stop whenever you want, and the leaders will see that you stopped.</string>
    <string name="trip_share">Share my location</string>
    <string name="trip_decline">No thanks</string>
    <string name="trip_sharing_first">You are sharing your location with the leaders. The first position goes out as soon as the phone has a fix.</string>
    <string name="trip_sharing_last">You are sharing your location with the leaders, every %1$d min. Last sent %2$s.</string>
    <string name="trip_leader_asked">A leader asked where you are: your position goes out every minute for a while.</string>
    <string name="trip_sos">I\'m lost</string>
    <string name="trip_sos_off">I\'m safe now</string>
    <string name="trip_sos_on">The leaders have been alerted that you are lost. Your position goes out every minute. Stay where you are if you can.</string>
