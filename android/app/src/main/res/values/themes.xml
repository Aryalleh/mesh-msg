<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the dark theme so there is no white flash at start. -->
    <style name="Theme.MeshMsg" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="window_background">#0B1120</color>
    <color name="notification_accent">#2563EB</color>
    <color name="ic_launcher_background">#000000</color>
</resources>
