(version 1)

(rule "JLC: NPTH to copper"
	(condition "A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.2mm)))

(rule "JLC: SMD pad to pad, different nets"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net")
	(constraint clearance (min 0.15mm)))

(rule "AXP2101 0.4 mm pitch: pours keep 0.15 mm from its pins"
	(condition "A.Type == 'Zone' && B.Parent.Reference == 'U1'")
	(constraint clearance (min 0.15mm)))
